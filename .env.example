# Copy this file to .env.local. With every value empty, Bottle still runs on your machine:
# it uses a local Postgres in ~/.bottle/pg, a local account, and prints emails in the server log.

# The address of the site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres. Any Postgres works. Neon has a free tier: https://neon.tech
DATABASE_URL=

# Kinde: sign-in and billing. https://kinde.com
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/app
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
# The client id of a "Device and IoT" application in Kinde. The CLI signs in with it.
KINDE_DEVICE_CLIENT_ID=
# The code of your paid plan in Kinde
KINDE_PRO_PLAN_CODE=pro

# Email. Resend has a free tier: https://resend.com
RESEND_API_KEY=
BOTTLE_FROM="Bottle <bottle@example.com>"

# A long random string. The ticker sends it with each call to /api/tick.
TICK_SECRET=
